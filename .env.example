# Supabase (required for auth, applications, and payments)
# Add the same keys in Vercel: Project → Settings → Environment Variables
# Apply to Production, Preview, and Development, then redeploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayHero (server-side only)
PAYHERO_BASIC_AUTH_TOKEN=
# Or use username/password instead of BASIC_AUTH_TOKEN:
# PAYHERO_API_USERNAME=
# PAYHERO_API_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_CHANNEL_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
