# Supabase (required for auth and applications)
#
# Vercel deploy: Project → Settings → Environment Variables
# Add ALL variables below for Production, Preview, and Development, then Redeploy.
# NEXT_PUBLIC_* values are baked in at build time — a redeploy is required after adding them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# UpesiPay (M-Pesa STK Push)
UPESIPAY_API_USERNAME=
UPESIPAY_API_PASSWORD=
UPESIPAY_BASIC_AUTH=
UPESIPAY_CHANNEL_ID=99
NEXT_PUBLIC_APP_URL=https://nyotafund-kyn8a54ak-gennassirs-projects.vercel.app
