# Supabase (required for auth, applications, and payments)
#
# Vercel deploy: Project → Settings → Environment Variables
# Add ALL variables below for Production, Preview, and Development, then Redeploy.
# NEXT_PUBLIC_* values are baked in at build time — a redeploy is required after adding them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayHero (server-side only)
PAYHERO_BASIC_AUTH_TOKEN=
# Or use username/password instead of BASIC_AUTH_TOKEN:
# PAYHERO_API_USERNAME=
# PAYHERO_API_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_CHANNEL_ID=
# PayHero callback: https://nyotafund-orpin.vercel.app/api/payments/callback
NEXT_PUBLIC_APP_URL=https://nyotafund-orpin.vercel.app
